        "互动交谈": [
          {
            "filename": "香奈美语音-026CN.mp3",
            "text": "假如重来一次，我还是会选择成为偶像歌手。毕竟，我无论如何都不能让粉丝们失望。",
            "voiceTag": "互动交谈"
          },
          {
            "filename": "香奈美语音-027CN.mp3",
            "text": "唱歌对我来说有非比寻常的意义，我需要用这种方式去铭记过去、现在和将来。",
            "voiceTag": "互动交谈"
          }
        ],
        "打断角色状态": [
          {
            "filename": "香奈美语音-049CN.mp3",
            "text": "抱歉~你是觉得我有点吵到你了吗？",
            "voiceTag": "打断角色状态"
          },
          {
            "filename": "香奈美语音-050CN.mp3",
            "text": "你想学编曲吗？那么，我以后找个机会教你吧~",
            "voiceTag": "打断角色状态"
          }
        ],
        "获得角色": [
          {
            "filename": "香奈美语音-018CN.mp3",
            "text": "初次见面，我叫香奈美。如果你喜欢我的话，就来听听我的演唱会吧！",
            "voiceTag": "获得角色"
          }
        ]
      },
      "match": {
        "回合开场": [
          {
            "filename": "香奈美语音-068CN.mp3",
            "text": "一切准备就绪，我的演出要开始了哦！",
            "voiceTag": "回合开场"
          },
          {
            "filename": "香奈美语音-069CN.mp3",
            "text": "声浪下的渴望，就由香奈美来回应吧！",
            "voiceTag": "回合开场"
          }
        ],
        "战斗失败": [
          {
            "filename": "Kanami_Result-0038_CN.mp3",
            "text": "怎么才能避免临场发挥失常呢？",
            "voiceTag": "战斗失败"
          },
          {
            "filename": "Kanami_Result-0040_CN.mp3",
            "text": "即使在低谷，香奈美也会撑下去的。",
            "voiceTag": "战斗失败"
          }
        ],
        "战斗胜利": [
          {
            "filename": "Kanami_Result-0034_CN.mp3",
            "text": "真是一场不错的即兴表演呢。",
            "voiceTag": "战斗胜利"
          },
          {
            "filename": "Kanami_Result-0036_CN.mp3",
            "text": "我预感胜利会一直延续下去喔。",
            "voiceTag": "战斗胜利"
          }
        ]
      },
      "skin": {
        "回合开场": [
          {
            "filename": "Kanami_Hall_org01-0014_CN.mp3",
            "text": "飘逸的裙摆就像是盛开的花。",
            "voiceTag": "回合开场"
          },
          {
            "filename": "Kanami_Hall_org01-0016_CN.mp3",
            "text": "这是一种甜美的诱惑哦。",
            "voiceTag": "回合开场"
          }
        ],
        "战斗胜利": [
          {
            "filename": "Kanami_Result_org01-0025_CN.mp3",
            "text": "一直走花路吧。 走花路：饭圈常用语，意思是希望顺顺利利，一直有好事发生。",
