{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanami.top/schemas/skill-manifest.schema.json",
  "title": "Deterministic Codex skill package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "skill_name",
    "payload_sha256",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 1
    },
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!manifest\\.json$)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[^/\\u0000]+/)*[^/\\u0000]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
