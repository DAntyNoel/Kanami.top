{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanami.top/schemas/source-record.schema.json",
  "title": "香奈美蒸馏 source record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "url",
    "publisher",
    "published_at",
    "version",
    "accessed_at",
    "material_type",
    "canon_context",
    "context_router",
    "language",
    "timeline_phase",
    "scene",
    "dimensions",
    "characters_present",
    "counterparties",
    "evidence_summary",
    "short_quote",
    "timestamp",
    "inference",
    "conflicts",
    "status",
    "canon_evidence"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^SRC-(?!XXXX$)[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https://(?!example\\.invalid(?:[/:?#]|$)|REPLACE)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#].*)?$"
    },
    "local_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
      },
      "uniqueItems": true
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "date"
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "material_type": {
      "enum": [
        "setting",
        "story",
        "dialogue",
        "voice",
        "pv",
        "song",
        "letter"
      ]
    },
    "canon_context": {
      "enum": [
        "base",
        "dorm",
        "battle",
        "pledge",
        "skin",
        "event",
        "system",
        "mixed"
      ]
    },
    "context_router": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "enum": [
            "public_idol",
            "private_familiar",
            "mission_volunteer",
            "battle_stage",
            "vulnerable_reflective",
            "pledge_intimate"
          ]
        },
        "secondary": {
          "oneOf": [
            {
              "enum": [
                "public_idol",
                "private_familiar",
                "mission_volunteer",
                "battle_stage",
                "vulnerable_reflective",
                "pledge_intimate"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "language": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 2
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        }
      ]
    },
    "timeline_phase": {
      "enum": [
        "childhood",
        "trainee",
        "idol",
        "preton",
        "scissors",
        "current",
        "alternate-skin",
        "unknown"
      ]
    },
    "scene": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "writings",
          "conversations",
          "expression_dna",
          "decisions",
          "external_views",
          "timeline"
        ]
      },
      "uniqueItems": true
    },
    "characters_present": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "counterparties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "short_quote": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "timestamp": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:(?:[0-9]{2}:)?[0-5][0-9]:[0-5][0-9])(?:-(?:(?:[0-9]{2}:)?[0-5][0-9]:[0-5][0-9]))?$"
      }
    },
    "inference": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "status": {
      "enum": [
        "candidate",
        "inspected",
        "accepted",
        "excluded",
        "blocked"
      ]
    },
    "canon_evidence": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "published_at": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "inspected",
              "accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_summary": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "inspected",
                  "accepted"
                ]
              }
            }
          },
          {
            "properties": {
              "material_type": {
                "enum": [
                  "voice",
                  "pv",
                  "song"
                ]
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "timestamp": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "inspected",
                  "accepted"
                ]
              }
            }
          },
          {
            "properties": {
              "material_type": {
                "enum": [
                  "story",
                  "dialogue",
                  "letter"
                ]
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "counterparties": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "canon_context": {
            "enum": [
              "pledge"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "context_router": {
            "properties": {
              "primary": {
                "enum": [
                  "pledge_intimate"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
