# Copy values into cliproxy/.env for local use.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Host port exposed on 127.0.0.1. The container listens on 8317 internally for Cloudflare Tunnel.
PORT=8317
DEPLOY=cloud
# Local Docker keeps config.yaml persistent. Render can keep startup overwrite enabled with CONFIG_OVERWRITE=true.
CONFIG_OVERWRITE=false

# Optional: non-empty value enables the remote management panel.
MANAGEMENT_PASSWORD=

# Client API key. Alternatively, create secrets/api-keys.txt with one key per line.
API_KEYS=replace-with-client-api-key

# Optional: CPA Usage Keeper, started with docker-compose.usage-keeper.yml.
# Host port exposed on 127.0.0.1 for CPA Usage Keeper.
USAGE_KEEPER_PORT=12704
# Restart scripts start CPA Usage Keeper by default. Set false to skip it.
START_USAGE_KEEPER=true
# Restart scripts start the Keeper Cloudflare Tunnel when this token is set.
KEEPER_TUNNEL_TOKEN=
# Set false to skip the Keeper Cloudflare Tunnel while keeping the token in .env.
START_KEEPER_TUNNEL=true
# CLIProxyAPI usage queue retention for external collectors. Max: 3600.
REDIS_USAGE_QUEUE_RETENTION_SECONDS=3600

# Docker-managed CLIProxyAPI memory killbot. The status endpoint is local-only.
KILLBOT_STATUS_PORT=12715
# Docker working set thresholds (usage minus inactive_file). The local Docker
# Desktop WSL VM currently exposes about 14 GiB, so host-level 32/64 GiB
# thresholds would never be reached by this container monitor.
KILLBOT_CONTAINER_WARN_BYTES=8GiB
KILLBOT_CONTAINER_RESTART_BYTES=12GiB
KILLBOT_CONTAINER_RECOVERY_BYTES=6GiB
# A threshold must be met for this many consecutive 30-second samples.
KILLBOT_CONTAINER_WARN_SAMPLES=3
KILLBOT_CONTAINER_RESTART_SAMPLES=3
KILLBOT_SAMPLE_INTERVAL=30s
# Docker API timeout, graceful-stop timeout, and restart-storm cooldown.
KILLBOT_DOCKER_TIMEOUT=8s
KILLBOT_RESTART_TIMEOUT=15s
KILLBOT_RESTART_COOLDOWN=30m
KILLBOT_ERROR_SAMPLES=3
# Restart snapshots and Docker logs are bounded.
KILLBOT_SNAPSHOT_RETENTION=20
# CLIPROXY_MEMORY_KILLBOT_IMAGE=kanami-cliproxy-memory-killbot:local
# Defaults to MANAGEMENT_PASSWORD when empty.
# USAGE_KEEPER_PASSWORD=replace-with-usage-dashboard-password
# Optional sub-path reverse proxy prefix, for example /usage.
# USAGE_KEEPER_BASE_PATH=

# Optional: when Docker Hub is slow or times out, switch base images to a mirror.
# GO_BUILDER_IMAGE=docker.1ms.run/library/golang:1.26-alpine
# RUNTIME_IMAGE=docker.1ms.run/library/alpine:3.23
# CLOUDFLARED_IMAGE=docker.1ms.run/cloudflare/cloudflared:latest
# GOPROXY=https://goproxy.cn,direct
