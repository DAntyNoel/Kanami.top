# Copy values into cliproxy/.env for local use.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Host port exposed on 127.0.0.1. The container listens on 8317 internally for Cloudflare Tunnel.
PORT=8317
DEPLOY=cloud

# Optional: non-empty value enables the remote management panel.
MANAGEMENT_PASSWORD=

# Client API key. Alternatively, create secrets/api-keys.txt with one key per line.
API_KEYS=replace-with-client-api-key

# Optional: CPA Usage Keeper, started with docker-compose.usage-keeper.yml.
USAGE_KEEPER_PORT=18080
# Defaults to MANAGEMENT_PASSWORD when empty.
# USAGE_KEEPER_PASSWORD=replace-with-usage-dashboard-password
# Optional sub-path reverse proxy prefix, for example /usage.
# USAGE_KEEPER_BASE_PATH=

# Optional: when Docker Hub is slow or times out, switch base images to a mirror.
# GO_BUILDER_IMAGE=docker.1ms.run/library/golang:1.26-alpine
# RUNTIME_IMAGE=docker.1ms.run/library/alpine:3.23
# CLOUDFLARED_IMAGE=docker.1ms.run/cloudflare/cloudflared:latest
# GOPROXY=https://goproxy.cn,direct
