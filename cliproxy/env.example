# 复制为 cliproxy/env 或 cliproxy/.env，真实密钥不要提交到仓库。
PORT=8317
DEPLOY=cloud

# 管理面板密码。留空会禁用远程管理密钥。
MANAGEMENT_PASSWORD=

# 客户端访问 API key。可用逗号分隔多个 key，也可改用 API_KEYS_FILE 指向文件。
API_KEYS=replace-with-client-api-key
# API_KEYS_FILE=/run/secrets/api-keys.txt

# OAuth auth 可通过 base64、原始 JSON 或文件路径提供。
CODEX_AUTH_REQUIRED=false
# CODEX_AUTH_JSON_B64=
# CODEX_AUTH_JSON=
# CODEX_AUTH_SOURCE=/run/secrets/codex-auth.json

# 可选代理。
# PROXY_URL=socks5://127.0.0.1:1080
