# 复制为 chatbot/env 或 chatbot/.env，真实密钥不要提交到仓库。
PORT=12703
HOST=127.0.0.1
BASE_URL=https://api.openai.com/v1
LOCAL_CLIPROXY_PORT=12702
LOCAL_CLIPROXY_HOST=127.0.0.1
LOCAL_CLIPROXY_PROBE_MS=350
API_KEY=sk-your-key
MODEL=gpt-4o-mini
